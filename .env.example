# Local private website configuration example. Never put real values here.
SITE_PASSWORD=replace-with-a-unique-passphrase-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=10000
NODE_ENV=development

# Server-side encrypted shared AI vault. Use a unique random secret; never commit the real value.
VAULT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# On Render, point this to a mounted persistent disk for data that survives redeploys.
VAULT_DATA_DIR=./data
